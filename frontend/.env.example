# Leave empty to use the Vite dev proxy (/api -> backend).
# For production builds, set the absolute API origin, e.g. https://api.example.gov
VITE_API_URL=

# Dev-only: backend target used by Vite proxy
VITE_DEV_API_PROXY=http://localhost:8080

# FINAL PRESENTATION: set to false so the SPA calls the live seeded backend
# (not in-browser demo stubs). Default DEV mode uses stubs when unset.
VITE_DEMO_MODE=false
